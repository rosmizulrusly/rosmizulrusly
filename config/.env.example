# Application
NODE_ENV=development
PORT=3000
APP_NAME=Gold Trading Platform
APP_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/gold-trading
MONGODB_TEST_URI=mongodb://localhost:27017/gold-trading-test

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption
ENCRYPTION_KEY=your-encryption-key-min-32-characters-change-in-production

# Blockchain
BLOCKCHAIN_NETWORK=ethereum-sepolia
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR-PROJECT-ID
BLOCKCHAIN_PRIVATE_KEY=your-private-key-for-contract-deployment
GOLD_TRADING_CONTRACT_ADDRESS=0x...

# Payment Gateways
# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cryptocurrency Payments
COINBASE_API_KEY=
COINBASE_API_SECRET=
BTCPAY_SERVER_URL=
BTCPAY_API_KEY=

# KYC/AML Providers
# Onfido
ONFIDO_API_TOKEN=
ONFIDO_REGION=eu

# ComplyAdvantage
COMPLYADVANTAGE_API_KEY=

# SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@goldtrading.com

# AWS S3 (for document storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=gold-trading-documents

# Courier APIs
BRINKS_API_KEY=
BRINKS_API_URL=
G4S_API_KEY=
G4S_API_URL=

# Google Maps API (for GPS tracking)
GOOGLE_MAPS_API_KEY=

# Security
SESSION_SECRET=your-session-secret-min-32-characters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=

# Feature Flags
ENABLE_BLOCKCHAIN=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false

# Business Settings
DEFAULT_TRANSACTION_FEE_PERCENT=1.5
VAULT_STORAGE_FEE_PER_100G=10
MIN_ORDER_AMOUNT=100
MAX_ORDER_AMOUNT=1000000

# Compliance
KYC_REQUIRED=true
AML_CHECK_REQUIRED=true
TRANSACTION_MONITORING_ENABLED=true

# Payment URLs
PAYMENT_URL=https://pay.goldtrading.com
PAYMENT_SUCCESS_URL=https://goldtrading.com/payment/success
PAYMENT_CANCEL_URL=https://goldtrading.com/payment/cancel
